# SPDX-License-Identifier: Apache-2.0
# Extend the pinned static ash profile with the M18 configure and POSIX applets.
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_AWK=y
CONFIG_BASENAME=y
CONFIG_BUSYBOX=y
CONFIG_BUSYBOX_EXEC_PATH="/bootstrap/busybox"
CONFIG_CHMOD=y
CONFIG_CMP=y
CONFIG_CP=y
CONFIG_CUT=y
CONFIG_DIFF=y
CONFIG_DIRNAME=y
CONFIG_EGREP=y
CONFIG_ENV=y
CONFIG_EXPR=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_FIND_PAREN=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_LS_FOLLOWLINKS=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FIND=y
CONFIG_GREP=y
CONFIG_HEAD=y
CONFIG_INSTALL=y
CONFIG_KILL=y
CONFIG_LN=y
CONFIG_LONG_OPTS=y
CONFIG_MKDIR=y
CONFIG_MKTEMP=y
CONFIG_MV=y
CONFIG_PRINTF=y
CONFIG_PWD=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_SED=y
CONFIG_SLEEP=y
CONFIG_SORT=y
CONFIG_TAIL=y
CONFIG_TOUCH=y
CONFIG_TR=y
CONFIG_UNAME=y
CONFIG_UNIQ=y
CONFIG_WC=y
